---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { heroSlides, type HeroSlideData } from '../../data/heroSlides';

export function getStaticPaths() {
  const products = heroSlides.filter(s => Boolean(s.slug && s.title));
  return products.map((item) => ({
    params: { slug: item.slug },
    props: { product: item }
  }));
}

interface Props {
  product: HeroSlideData;
}

const { product } = Astro.props;
const details = product.details;

// Other creations for complementary editorial gallery
const otherProducts = heroSlides
  .filter(s => Boolean(s.slug && s.title && s.slug !== product.slug))
  .slice(0, 3);
---
<BaseLayout title={`${product.title} — CARPE DIAM BOMBAY`}>
  <article class="product-page">
    <div class="product-container">
      <nav class="breadcrumb-nav">
        <a href="/the-edit" class="back-link">
          <svg width="22" height="12" viewBox="0 0 24 14" fill="none" class="back-arrow" aria-hidden="true">
            <line x1="24" y1="7" x2="2" y2="7" stroke="currentColor" stroke-width="1.2" />
            <polyline points="8 1 2 7 8 13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <span>The Edit</span>
        </a>
      </nav>

      <!-- Desktop 2-Column Editorial Composition -->
      <div class="product-hero-grid">
        <!-- Sticky Luxury Artwork Presentation -->
        <div class="product-visual-column">
          <div 
            class="product-visual-wrapper cinematic-image-wrapper" 
            data-reveal-image 
            data-parallax-image
          >
            <img 
              src={product.image} 
              alt={product.alt} 
              class="product-visual" 
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

        <!-- Editorial Description & Craft Column -->
        <div class="product-info-column stagger-text-group" data-reveal-text-group>
          <div class="product-header">
            <span class="collection-badge editorial-reveal-item" data-reveal-item>
              Carpe Diam Bombay · High Jewellery
            </span>
            <h1 class="pdp-title editorial-reveal-item" data-reveal-item>
              {product.title}
            </h1>
            {product.description && (
              <p class="pdp-materials editorial-reveal-item" data-reveal-item>
                {product.description}
              </p>
            )}
          </div>

          <div class="fine-divider editorial-reveal-item" data-reveal-item></div>

          {details && (
            <div class="product-narrative editorial-reveal-item" data-reveal-item>
              <p>{details.description}</p>
            </div>
          )}

          {details && (
            <div class="craft-editorial-section editorial-reveal-item" data-reveal-item>
              <h2 class="craft-eyebrow">The Craft</h2>
              <dl class="specs-editorial-list">
                <div class="spec-editorial-row editorial-reveal-item" data-reveal-item>
                  <dt>Gold</dt>
                  <dd>{details.gold}</dd>
                </div>
                <div class="spec-editorial-row editorial-reveal-item" data-reveal-item>
                  <dt>Gemstones</dt>
                  <dd>{details.gemstones}</dd>
                </div>
                <div class="spec-editorial-row editorial-reveal-item" data-reveal-item>
                  <dt>Diamonds</dt>
                  <dd>{details.diamonds}</dd>
                </div>
                <div class="spec-editorial-row editorial-reveal-item" data-reveal-item>
                  <dt>Provenance</dt>
                  <dd>{details.origin}</dd>
                </div>
              </dl>
            </div>
          )}

          <div class="action-editorial-section editorial-reveal-item" data-reveal-item>
            <a href={`/contact?inquiry=${product.slug}`} class="inquiry-btn">
              Request Private Viewing
            </a>
            <p class="service-note">
              Heirloom commission · Worldwide insured delivery · Certified provenance
            </p>
          </div>
        </div>
      </div>

      <!-- Complementary Creations Editorial Gallery -->
      {otherProducts.length > 0 && (
        <section class="complementary-section editorial-section-reveal" data-reveal-section>
          <div class="complementary-header">
            <span class="eyebrow">High Jewellery</span>
            <h2 class="complementary-title">Complementary Creations</h2>
          </div>
          <div class="complementary-grid" data-editorial-gallery>
            {otherProducts.map((item) => (
              <a href={`/the-edit/${item.slug}`} class="complementary-item editorial-gallery-item">
                <div class="item-visual-mask cinematic-image-wrapper" data-reveal-image>
                  <img src={item.image} alt={item.alt} loading="lazy" />
                </div>
                <div class="item-editorial-meta">
                  <h3 class="item-editorial-title">{item.title}</h3>
                  {item.description && <p class="item-editorial-materials">{item.description}</p>}
                  <span class="item-editorial-link">Discover Creation →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .product-page {
    padding: clamp(6.5rem, 11vh, 9.5rem) var(--spacing-header-x) clamp(4rem, 8vw, 7.5rem);
    background-color: var(--color-bg-dark);
    min-height: 100vh;
  }

  .product-container {
    max-width: 1360px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    margin-bottom: clamp(1.8rem, 3.5vh, 2.8rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    transition: color 0.3s var(--ease-luxury), transform 0.25s var(--ease-luxury);
  }

  .back-link:hover {
    color: var(--color-gold-light);
    transform: translateX(-4px);
  }

  .product-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(3rem, 6vw, 6rem);
    align-items: start;
    border-bottom: 1px solid var(--color-border-fine);
    padding-bottom: clamp(4rem, 7vw, 6rem);
    position: relative;
  }

  /* Sticky Left Column */
  .product-visual-column {
    position: sticky;
    top: 6.5rem;
  }

  .product-visual-wrapper {
    background-color: var(--color-bg-darker);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    position: relative;
  }

  .product-visual {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    user-select: none;
  }

  .product-visual-wrapper:hover .product-visual {
    transform: scale(1.025);
  }

  /* Right Column Editorial Content */
  .product-info-column {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    padding-top: 0.5rem;
  }

  .collection-badge {
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.85rem;
  }

  .pdp-title {
    font-size: clamp(2rem, 3.4vw, 3rem);
    letter-spacing: 0.08em;
    line-height: 1.2;
    color: var(--color-text-white);
    margin-bottom: 0.75rem;
  }

  .pdp-materials {
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    color: var(--color-gold-light);
    white-space: pre-line;
    line-height: 1.6;
    letter-spacing: 0.03em;
  }

  .fine-divider {
    width: 100%;
    height: 1px;
    background-color: var(--color-border-fine);
    margin: 0.2rem 0;
  }

  .product-narrative p {
    font-size: clamp(1.05rem, 1.15vw, 1.2rem);
    color: var(--color-text-muted);
    line-height: 1.85;
    letter-spacing: 0.02em;
  }

  /* Minimal Craft Specs with Delicate Dividers */
  .craft-editorial-section {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-top: 0.4rem;
  }

  .craft-eyebrow {
    font-size: 0.92rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.4rem;
  }

  .specs-editorial-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin: 0;
  }

  .spec-editorial-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1.2rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid rgba(197, 168, 108, 0.12);
    align-items: baseline;
  }

  .spec-editorial-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .spec-editorial-row dt {
    color: var(--color-gold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
  }

  .spec-editorial-row dd {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
    font-size: 0.98rem;
  }

  /* Action Section */
  .action-editorial-section {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 0.8rem;
  }

  .inquiry-btn {
    display: inline-block;
    text-align: center;
    background-color: var(--color-gold);
    color: #06110f;
    font-size: 0.98rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 1.15rem 2.4rem;
    transition: background-color 0.35s var(--ease-luxury), transform 0.25s var(--ease-luxury), box-shadow 0.35s var(--ease-luxury);
    text-decoration: none;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .inquiry-btn:hover {
    background-color: var(--color-gold-light);
    transform: translateY(-2px);
    box-shadow: 0 6px 26px rgba(197, 168, 108, 0.25);
  }

  .service-note {
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    letter-spacing: 0.05em;
  }

  /* Complementary Creations Editorial Gallery */
  .complementary-section {
    padding-top: clamp(4rem, 7vw, 6.5rem);
  }

  .complementary-header {
    text-align: center;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .complementary-header .eyebrow {
    display: block;
    font-size: 0.88rem;
    letter-spacing: 0.2em;
    color: var(--color-gold);
    margin-bottom: 0.6rem;
    text-transform: uppercase;
  }

  .complementary-title {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    letter-spacing: 0.08em;
    color: var(--color-text-white);
  }

  .complementary-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: clamp(2rem, 3.5vw, 3.5rem);
  }

  .complementary-item {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.4s var(--ease-luxury);
  }

  .item-visual-mask {
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: var(--color-bg-darker);
    border: 1px solid var(--color-border-subtle);
  }

  .item-visual-mask img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-luxury);
  }

  .complementary-item:hover .item-visual-mask img {
    transform: scale(1.04);
  }

  .item-editorial-meta {
    padding: 1.4rem 0.2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .item-editorial-title {
    font-size: 1.15rem;
    letter-spacing: 0.1em;
    color: var(--color-text-white);
    transition: color 0.3s ease;
  }

  .complementary-item:hover .item-editorial-title {
    color: var(--color-gold);
  }

  .item-editorial-materials {
    font-size: 0.94rem;
    color: var(--color-gold-light);
    line-height: 1.5;
    letter-spacing: 0.03em;
    white-space: pre-line;
  }

  .item-editorial-link {
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-top: 0.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.3s var(--ease-luxury), color 0.3s ease;
  }

  .complementary-item:hover .item-editorial-link {
    transform: translateX(4px);
    color: var(--color-gold-light);
  }

  /* Responsive Adjustments */
  @media (max-width: 900px) {
    .product-page {
      padding: 5.5rem 1.25rem 3.5rem;
    }

    .product-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .product-visual-column {
      position: static;
    }

    .spec-editorial-row {
      grid-template-columns: 95px 1fr;
    }

    .complementary-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
