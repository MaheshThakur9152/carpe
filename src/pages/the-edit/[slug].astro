---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { heroSlides, type HeroSlideData } from '../../data/heroSlides';

export function getStaticPaths() {
  const products = heroSlides.filter(s => Boolean(s.slug && s.title));
  return products.map((item) => ({
    params: { slug: item.slug },
    props: { product: item }
  }));
}

interface Props {
  product: HeroSlideData;
}

const { product } = Astro.props;
const details = product.details;

// Other creations for related section
const otherProducts = heroSlides
  .filter(s => Boolean(s.slug && s.title && s.slug !== product.slug))
  .slice(0, 3);
---
<BaseLayout title={`${product.title} — CARPE DIAM BOMBAY`}>
  <article class="product-page">
    <div class="product-container">
      <nav class="breadcrumb-nav">
        <a href="/the-edit" class="back-link">
          <svg width="24" height="14" viewBox="0 0 24 14" fill="none" class="back-arrow">
            <line x1="24" y1="7" x2="2" y2="7" stroke="currentColor" stroke-width="1.2" />
            <polyline points="8 1 2 7 8 13" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          The Edit
        </a>
      </nav>

      <div class="product-hero-grid">
        <div class="product-visual-wrapper">
          <img src={product.image} alt={product.alt} class="product-visual" />
        </div>

        <div class="product-info-column">
          <div class="product-header">
            <span class="collection-badge">Carpe Diam Bombay · High Jewellery</span>
            <h1 class="pdp-title">{product.title}</h1>
            {product.description && <p class="pdp-materials">{product.description}</p>}
          </div>

          {details && (
            <div class="product-narrative">
              <p>{details.description}</p>
            </div>
          )}

          {details && (
            <div class="specifications-box">
              <h2 class="specs-heading">Creation Details</h2>
              <dl class="specs-list">
                <div class="spec-row">
                  <dt>Gold</dt>
                  <dd>{details.gold}</dd>
                </div>
                <div class="spec-row">
                  <dt>Gemstones</dt>
                  <dd>{details.gemstones}</dd>
                </div>
                <div class="spec-row">
                  <dt>Diamonds</dt>
                  <dd>{details.diamonds}</dd>
                </div>
                <div class="spec-row">
                  <dt>Provenance</dt>
                  <dd>{details.origin}</dd>
                </div>
              </dl>
            </div>
          )}

          <div class="action-section">
            <a href={`/contact?inquiry=${product.slug}`} class="inquiry-btn">
              Request Private Viewing
            </a>
            <p class="service-note">
              Heirloom commission · Worldwide insured delivery · Certified provenance
            </p>
          </div>
        </div>
      </div>

      {otherProducts.length > 0 && (
        <section class="related-section">
          <div class="related-header">
            <span class="eyebrow">High Jewellery</span>
            <h2>Complementary Creations</h2>
          </div>
          <div class="related-grid">
            {otherProducts.map((item) => (
              <a href={`/the-edit/${item.slug}`} class="related-card">
                <div class="related-thumb">
                  <img src={item.image} alt={item.alt} loading="lazy" />
                </div>
                <div class="related-meta">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</BaseLayout>

<style>
  .product-page {
    padding: clamp(6.5rem, 11vh, 9rem) var(--spacing-header-x) clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bg-dark);
  }

  .product-container {
    max-width: 1300px;
    margin: 0 auto;
  }

  .breadcrumb-nav {
    margin-bottom: clamp(1.5rem, 3vh, 2.5rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--color-gold);
    transition: color 0.3s ease, transform 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-gold-light);
    transform: translateX(-3px);
  }

  .product-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: clamp(3.5rem, 6vw, 5.5rem);
  }

  .product-visual-wrapper {
    background-color: var(--color-bg-darker);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    position: sticky;
    top: 6rem;
  }

  .product-visual {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .product-visual-wrapper:hover .product-visual {
    transform: scale(1.03);
  }

  .product-info-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .collection-badge {
    font-size: 0.85rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.8rem;
  }

  .pdp-title {
    font-size: clamp(1.8rem, 3.2vw, 2.8rem);
    letter-spacing: 0.1em;
    color: var(--color-text-white);
    margin-bottom: 0.6rem;
  }

  .pdp-materials {
    font-size: 1.15rem;
    color: var(--color-gold);
    white-space: pre-line;
    line-height: 1.5;
  }

  .product-narrative p {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .specifications-box {
    background-color: var(--color-bg-darker);
    border: 1px solid var(--color-border-subtle);
    padding: clamp(1.5rem, 3vw, 2.2rem);
  }

  .specs-heading {
    font-size: 1.15rem;
    letter-spacing: 0.12em;
    color: var(--color-gold-light);
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(197, 168, 108, 0.15);
    padding-bottom: 0.6rem;
  }

  .specs-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .spec-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 1rem;
    font-size: 1rem;
  }

  .spec-row dt {
    color: var(--color-gold);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: 0.88rem;
  }

  .spec-row dd {
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .action-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .inquiry-btn {
    display: inline-block;
    text-align: center;
    background-color: var(--color-gold);
    color: #06110f;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 1.1rem 2.2rem;
    transition: background-color 0.3s ease, transform 0.2s ease;
    text-decoration: none;
  }

  .inquiry-btn:hover {
    background-color: var(--color-gold-light);
    transform: translateY(-2px);
  }

  .service-note {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.45);
    text-align: center;
    letter-spacing: 0.04em;
  }

  .related-section {
    padding-top: clamp(3.5rem, 6vw, 5.5rem);
  }

  .related-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .related-header .eyebrow {
    display: block;
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: var(--color-gold);
    margin-bottom: 0.6rem;
  }

  .related-header h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    color: var(--color-text-white);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .related-card {
    background-color: var(--color-bg-darker);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    border-color: rgba(197, 168, 108, 0.5);
  }

  .related-thumb {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .related-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .related-meta {
    padding: 1.4rem;
  }

  .related-meta h3 {
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    color: var(--color-text-white);
    margin-bottom: 0.4rem;
  }

  .related-meta p {
    font-size: 0.9rem;
    color: var(--color-gold);
    line-height: 1.5;
  }

  @media (max-width: 860px) {
    .product-hero-grid {
      grid-template-columns: 1fr;
    }
    .product-visual-wrapper {
      position: static;
    }
  }
</style>
