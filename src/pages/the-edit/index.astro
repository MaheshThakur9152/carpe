---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { heroSlides } from '../../data/heroSlides';

const products = heroSlides.filter(s => Boolean(s.slug && s.title));
---
<BaseLayout title="The Edit — CARPE DIAM BOMBAY">
  <div class="the-edit-page">
    <header class="edit-header stagger-text-group" data-reveal-text-group>
      <span class="eyebrow editorial-reveal-item" data-reveal-item>Curated Collection</span>
      <h1 class="editorial-reveal-item" data-reveal-item>The Edit</h1>
      <p class="edit-intro editorial-reveal-item" data-reveal-item>
        An assemblage of fine jewellery, bespoke heirlooms and botanical high creations handcrafted in 14kt gold.
      </p>
    </header>

    <div class="edit-gallery editorial-section-reveal" data-reveal-section>
      <div class="gallery-grid" data-editorial-gallery>
        {products.map((item) => (
          <a href={`/the-edit/${item.slug}`} class="edit-item editorial-gallery-item">
            <div class="item-visual cinematic-image-wrapper" data-reveal-image>
              <img src={item.image} alt={item.alt} loading="lazy" />
            </div>
            <div class="item-meta">
              <h2 class="item-title">{item.title}</h2>
              {item.description && <p class="item-materials">{item.description}</p>}
              <span class="item-cta">Discover Creation →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .the-edit-page {
    padding: clamp(7rem, 12vh, 10rem) var(--spacing-header-x) clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bg-dark);
    min-height: 100vh;
  }

  .edit-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto clamp(3.5rem, 6vw, 5.5rem);
  }

  .eyebrow {
    font-size: 0.88rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.8rem;
  }

  .edit-header h1 {
    font-size: clamp(2.5rem, 4.5vw, 4rem);
    letter-spacing: 0.08em;
    color: var(--color-text-white);
    margin-bottom: 1.2rem;
  }

  .edit-intro {
    font-size: clamp(1.05rem, 1.2vw, 1.25rem);
    color: var(--color-text-muted);
    line-height: 1.8;
    letter-spacing: 0.02em;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: clamp(2.5rem, 4vw, 4rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  .edit-item {
    background-color: transparent;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.4s var(--ease-luxury);
  }

  .item-visual {
    aspect-ratio: 16/9;
    overflow: hidden;
    background-color: var(--color-bg-darker);
    border: 1px solid var(--color-border-subtle);
  }

  .item-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease-luxury);
  }

  .edit-item:hover .item-visual img {
    transform: scale(1.035);
  }

  .item-meta {
    padding: 1.4rem 0.2rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .item-title {
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    color: var(--color-text-white);
    transition: color 0.3s ease;
  }

  .edit-item:hover .item-title {
    color: var(--color-gold);
  }

  .item-materials {
    font-size: 0.95rem;
    color: var(--color-gold-light);
    white-space: pre-line;
    line-height: 1.55;
    letter-spacing: 0.03em;
  }

  .item-cta {
    font-size: 0.88rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-top: 0.4rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: transform 0.3s var(--ease-luxury), color 0.3s ease;
  }

  .edit-item:hover .item-cta {
    transform: translateX(4px);
    color: var(--color-gold-light);
  }

  @media (max-width: 768px) {
    .the-edit-page {
      padding: 5.5rem 1.25rem 3.5rem;
    }
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
</style>
