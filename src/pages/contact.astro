---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact & Appointments — CARPE DIAM BOMBAY">
  <div class="contact-page">
    <div class="contact-container">
      <header class="contact-header">
        <span class="eyebrow">Private Concierge</span>
        <h1>Appointments & Inquiries</h1>
        <p class="contact-intro">
          We invite you to experience our collections in person at our Bombay atelier or initiate a bespoke commission.
        </p>
      </header>

      <div class="contact-content-grid">
        <div class="contact-info">
          <div class="info-block">
            <h3>The Bombay Atelier</h3>
            <p>Carpe Diam High Jewellery</p>
            <p>Kala Ghoda, Fort</p>
            <p>Bombay, Maharashtra 400001</p>
          </div>

          <div class="info-block">
            <h3>Private Viewings</h3>
            <p>Monday — Saturday</p>
            <p>11:00 AM — 7:00 PM IST</p>
            <p class="subtle-note">Strictly by prior confirmation</p>
          </div>

          <div class="info-block">
            <h3>Direct Liaison</h3>
            <p>concierge@carpediam.com</p>
            <p>+91 (022) 2284 9000</p>
          </div>
        </div>

        <div class="contact-form-wrapper">
          <form class="appointment-form" onsubmit="event.preventDefault(); alert('Thank you. Our atelier concierge will contact you shortly.');">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required placeholder="Lady / Gentleman" />
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="client@example.com" />
            </div>

            <div class="form-group">
              <label for="interest">Area of Interest</label>
              <select id="interest" name="interest">
                <option value="appointment">Private Atelier Appointment</option>
                <option value="bespoke">Bespoke Commission</option>
                <option value="polki">Polki & High Jewellery Inquiries</option>
                <option value="other">General Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Your inquiry or desired appointment date..."></textarea>
            </div>

            <button type="submit" class="submit-btn">Request Viewing</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding: clamp(7rem, 12vh, 10rem) var(--spacing-header-x) clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bg-dark);
  }

  .contact-container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .contact-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto clamp(3.5rem, 6vw, 5rem);
  }

  .eyebrow {
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.8rem;
  }

  .contact-header h1 {
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    color: var(--color-text-white);
    margin-bottom: 1.2rem;
  }

  .contact-intro {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .contact-content-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(3rem, 6vw, 6rem);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: clamp(3rem, 5vw, 4.5rem);
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .info-block h3 {
    font-size: 1.25rem;
    color: var(--color-gold-light);
    margin-bottom: 0.75rem;
    letter-spacing: 0.1em;
  }

  .info-block p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .subtle-note {
    font-style: italic;
    color: var(--color-gold-muted) !important;
  }

  .appointment-form {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    background-color: var(--color-bg-darker);
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--color-border-subtle);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background-color: #0b1a18;
    border: 1px solid rgba(197, 168, 108, 0.3);
    color: var(--color-text-white);
    padding: 0.85rem 1rem;
    font-size: 1.05rem;
    border-radius: 0;
    transition: border-color 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .submit-btn {
    margin-top: 0.5rem;
    background-color: var(--color-gold);
    color: #06110f;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    padding: 1rem 2rem;
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .submit-btn:hover {
    background-color: var(--color-gold-light);
  }

  @media (max-width: 800px) {
    .contact-content-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
