---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact & Appointments — CARPE DIAM BOMBAY">
  <div class="contact-page">
    <div class="contact-container">
      <header class="contact-header stagger-text-group" data-reveal-text-group>
        <span class="eyebrow editorial-reveal-item" data-reveal-item>Private Concierge</span>
        <h1 class="editorial-reveal-item" data-reveal-item>Appointments & Inquiries</h1>
        <p class="contact-intro editorial-reveal-item" data-reveal-item>
          We invite you to experience our collections in person at our Bombay atelier or initiate a bespoke commission.
        </p>
      </header>

      <div class="contact-content-grid editorial-section-reveal" data-reveal-section>
        <div class="contact-info">
          <div class="info-block">
            <h3>The Bombay Atelier</h3>
            <p>Carpe Diam High Jewellery</p>
            <p>506 93 East, Mahakali Caves Rd</p>
            <p>Shanti Nagar, Andheri East</p>
            <p>Mumbai, Maharashtra 400093</p>
          </div>

          <div class="info-block">
            <h3>Private Viewings</h3>
            <p>Monday — Saturday</p>
            <p>11:00 AM — 7:00 PM IST</p>
            <p class="subtle-note">Strictly by prior confirmation</p>
          </div>

          <div class="info-block">
            <h3>Direct Liaison</h3>
            <p>concierge@carpediam.com</p>
            <p>+91 (022) 2284 9000</p>
          </div>
        </div>

        <div class="contact-form-wrapper">
          <form class="appointment-form">
            <div class="form-group">
              <label for="name">Full Name</label>
              <input type="text" id="name" name="name" required placeholder="Lady / Gentleman" />
            </div>

            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="client@example.com" />
            </div>

            <div class="form-group">
              <label for="interest">Area of Interest</label>
              <select id="interest" name="interest">
                <option value="appointment">Private Atelier Appointment</option>
                <option value="bespoke">Bespoke Commission</option>
                <option value="polki">Polki & High Jewellery Inquiries</option>
                <option value="other">General Inquiry</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="4" placeholder="Your inquiry or desired appointment date..."></textarea>
            </div>

            <button type="submit" class="submit-btn">Request Viewing</button>
          </form>
        </div>
      </div>
    </div>
  </div>

  <script>
    function setupContactForm() {
      const params = new URLSearchParams(window.location.search);
      const inquiry = params.get('inquiry');
      const msg = document.getElementById('message') as HTMLTextAreaElement | null;
      const interest = document.getElementById('interest') as HTMLSelectElement | null;
      if (inquiry && interest) interest.value = 'appointment';
      if (inquiry && msg && !msg.value) {
        const formatted = inquiry.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
        msg.value = `I am interested in requesting a private viewing of ${formatted}.`;
      }

      const form = document.querySelector('.appointment-form') as HTMLFormElement | null;
      if (!form || form.dataset.bound) return;
      form.dataset.bound = 'true';

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = (data.get('name') as string) || '';
        const email = (data.get('email') as string) || '';
        const area = (data.get('interest') as string) || '';
        const note = (data.get('message') as string) || '';

        const subject = encodeURIComponent(`Private Viewing Request: ${name}`);
        const body = encodeURIComponent(
          `Client: ${name}\nEmail: ${email}\nInterest: ${area}\n\nInquiry Details:\n${note}`
        );
        window.location.href = `mailto:concierge@carpediam.com?subject=${subject}&body=${body}`;
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupContactForm);
    } else {
      setupContactForm();
    }
    document.addEventListener('astro:page-load', setupContactForm);
  </script>
</BaseLayout>

<style>
  .contact-page {
    padding: clamp(7rem, 12vh, 10rem) var(--spacing-header-x) clamp(4rem, 8vw, 7rem);
    background-color: var(--color-bg-dark);
    width: 100%;
    box-sizing: border-box;
  }

  .contact-container {
    max-width: 1100px;
    width: 100%;
    margin: 0 auto;
    box-sizing: border-box;
  }

  .contact-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto clamp(3rem, 5vw, 4.5rem);
  }

  .eyebrow {
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: block;
    margin-bottom: 0.8rem;
  }

  .contact-header h1 {
    font-size: clamp(2rem, 3.8vw, 3.4rem);
    color: var(--color-text-white);
    margin-bottom: 1.2rem;
  }

  .contact-intro {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .contact-content-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: clamp(2.5rem, 5vw, 5rem);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: clamp(2.5rem, 4vw, 4rem);
    width: 100%;
    box-sizing: border-box;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 2.2rem;
  }

  .info-block h3 {
    font-size: 1.25rem;
    color: var(--color-gold-light);
    margin-bottom: 0.75rem;
    letter-spacing: 0.1em;
  }

  .info-block p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .subtle-note {
    font-style: italic;
    color: var(--color-gold-muted) !important;
  }

  .contact-form-wrapper {
    width: 100%;
    box-sizing: border-box;
  }

  .appointment-form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    background-color: var(--color-bg-darker);
    padding: clamp(1.5rem, 3.5vw, 2.8rem);
    border: 1px solid var(--color-border-subtle);
    width: 100%;
    box-sizing: border-box;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    box-sizing: border-box;
  }

  .form-group label {
    font-size: 0.95rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold-light);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background-color: #0b1a18;
    border: 1px solid rgba(197, 168, 108, 0.3);
    color: var(--color-text-white);
    padding: 0.85rem 1rem;
    font-size: 1.05rem;
    border-radius: 0;
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
    transition: border-color 0.3s ease;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .submit-btn {
    margin-top: 0.5rem;
    background-color: var(--color-gold);
    color: #06110f;
    font-size: 1.02rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 1.1rem 2rem;
    width: 100%;
    box-sizing: border-box;
    transition: background-color 0.35s var(--ease-luxury), transform 0.25s var(--ease-luxury), box-shadow 0.35s var(--ease-luxury);
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.2);
  }

  .submit-btn:hover {
    background-color: var(--color-gold-light);
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(197, 168, 108, 0.22);
  }

  @media (max-width: 768px) {
    .contact-page {
      padding: 5.5rem 1.25rem 3.5rem;
    }

    .contact-content-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .appointment-form {
      padding: 1.4rem 1.1rem;
    }
  }
</style>
