---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="The Atelier — CARPE DIAM BOMBAY">
  <div class="atelier-page">
    <div class="atelier-hero">
      <div class="atelier-hero-bg">
        <img src="/Homepage-1.jpg" alt="Atelier Landscape" class="hero-image" />
      </div>
      <div class="hero-text-overlay">
        <span class="eyebrow">The Atelier</span>
        <h1>Bombay Heritage</h1>
      </div>
    </div>

    <section class="atelier-body">
      <div class="content-wrapper">
        <div class="prose-section">
          <h2>The Art of Polki & Carved Gems</h2>
          <p>
            Rooted in the coastal tapestry and grand artistic traditions of Bombay, Carpe Diam breathes renewed modern life into royal Indian jewelcraft.
          </p>
          <p>
            Every jewel begins with character: uncut diamonds that retain their organic geometry, juxtaposed against hand-carved tanzanite and luscious Colombian-origin emeralds. Our goldsmiths fashion each bezel by hand in 14kt gold, creating pieces of tactile gravity and timeless romance.
          </p>
        </div>

        <div class="craft-details-grid">
          <div class="craft-item">
            <h3>Provenance</h3>
            <p>Ethically sourced stones, individually selected for fire, inclusions, and depth of color.</p>
          </div>
          <div class="craft-item">
            <h3>Hand Enameling</h3>
            <p>Meenakari and miniature lacework fused at high temperatures to preserve brilliant floral hues.</p>
          </div>
          <div class="craft-item">
            <h3>Bespoke Commission</h3>
            <p>One-of-a-kind heirlooms tailored to the collector's personal narrative and proportions.</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .atelier-page {
    background-color: var(--color-bg-dark);
  }

  .atelier-hero {
    position: relative;
    height: 65vh;
    min-height: 450px;
    display: flex;
    align-items: flex-end;
    padding: clamp(3rem, 6vh, 5rem) var(--spacing-header-x);
    overflow: hidden;
  }

  .atelier-hero-bg {
    position: absolute;
    inset: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.65);
  }

  .hero-text-overlay {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: block;
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
  }

  .hero-text-overlay h1 {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    color: var(--color-text-white);
  }

  .atelier-body {
    padding: clamp(4rem, 8vw, 7rem) var(--spacing-header-x);
  }

  .content-wrapper {
    max-width: 900px;
    margin: 0 auto;
  }

  .prose-section {
    margin-bottom: 4rem;
  }

  .prose-section h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    color: var(--color-gold-light);
    margin-bottom: 1.5rem;
  }

  .prose-section p {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .craft-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2.5rem;
    border-top: 1px solid var(--color-border-subtle);
    padding-top: 3rem;
  }

  .craft-item h3 {
    font-size: 1.2rem;
    color: var(--color-gold);
    margin-bottom: 0.75rem;
  }

  .craft-item p {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
</style>
