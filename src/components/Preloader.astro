---
---
<div class="site-preloader" id="site-preloader" aria-hidden="true">
  <div class="preloader-spinner-wrapper">
    <svg class="preloader-arc" viewBox="0 0 100 100" width="130" height="130">
      <circle 
        class="arc-track" 
        cx="50" 
        cy="50" 
        r="44" 
        fill="none" 
        stroke="rgba(197, 168, 108, 0.12)" 
        stroke-width="1.2" 
      />
      <circle 
        class="arc-spinner" 
        cx="50" 
        cy="50" 
        r="44" 
        fill="none" 
        stroke="#cbb27a" 
        stroke-width="1.3" 
        stroke-dasharray="135 280" 
        stroke-linecap="round"
      />
    </svg>
  </div>
</div>

<style>
  .site-preloader {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background-color: #061512;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.7s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.7s ease;
    pointer-events: auto;
  }

  .site-preloader.is-loaded {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .preloader-spinner-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .preloader-arc {
    animation: rotateArc 1.6s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    display: block;
  }

  @keyframes rotateArc {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }
</style>

<script>
  function dismissPreloader() {
    const preloader = document.getElementById('site-preloader');
    if (!preloader || preloader.classList.contains('is-loaded')) return;

    // Grace period for hero assets to finish paint
    setTimeout(() => {
      preloader.classList.add('is-loaded');
      setTimeout(() => {
        preloader.style.display = 'none';
      }, 750);
    }, 600);
  }

  if (document.readyState === 'complete') {
    dismissPreloader();
  } else {
    window.addEventListener('load', dismissPreloader);
    // Safety fallback
    setTimeout(dismissPreloader, 2500);
  }
</script>
