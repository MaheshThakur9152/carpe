---
---
<!-- Fast early check to prevent flash on internal navigation within the same session -->
<script is:inline>
  try {
    var isReload = false;
    var nav = performance.getEntriesByType('navigation')[0];
    if (nav && nav.type === 'reload') {
      isReload = true;
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || (sessionStorage.getItem('cd_loader_seen') && !isReload)) {
      document.documentElement.classList.add('cd-skip-loader');
    }
  } catch (e) {}
</script>

<div class="loading-screen" id="site-loading-screen" aria-label="Carpe Diem" role="status">
  <img class="loader-logo" src="/carpediam-logo-original.svg" alt="Carpe Diam" />
  <div class="loader-line"><span></span></div>
  <span class="loader-label">Carpe Diem</span>
</div>

<style>
  :global(html.cd-skip-loader) #site-loading-screen {
    display: none !important;
  }

  .loading-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #173f3a;
    color: #e9e5dd;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: opacity 0.8s ease, visibility 0.8s ease;
    pointer-events: auto;
  }

  .loading-screen--done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .loader-mark {
    font: 500 5.5rem/1 'Amiri', serif;
    font-style: italic;
    margin-left: -0.3rem;
  }

  .loader-logo {
    width: 180px;
    height: auto;
    filter: invert(1);
    opacity: 0.92;
  }

  .loader-line {
    width: 104px;
    height: 1px;
    background: rgba(233, 229, 221, 0.25);
    margin: 28px 0 13px;
    overflow: hidden;
  }

  .loader-line span {
    display: block;
    height: 100%;
    width: 100%;
    background: #e9e5dd;
    transform-origin: left;
    animation: load 1.4s ease forwards;
  }

  .loader-label {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8d8980;
  }

  @keyframes load {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .loading-screen {
      display: none !important;
    }
    .loader-line span {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  function initLoadingScreen() {
    const loader = document.getElementById('site-loading-screen');
    if (!loader) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      loader.style.display = 'none';
      return;
    }

    let isReload = false;
    try {
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      isReload = nav ? nav.type === 'reload' : false;
    } catch (e) {}

    let alreadySeen = false;
    try {
      alreadySeen = !!sessionStorage.getItem('cd_loader_seen');
    } catch (e) {}

    if (alreadySeen && !isReload) {
      loader.style.display = 'none';
      return;
    }

    try {
      sessionStorage.setItem('cd_loader_seen', 'true');
    } catch (e) {}

    // Complete loader line animation at 1400ms, then transition away at 1500ms
    const dismissTimer = setTimeout(() => {
      loader.classList.add('loading-screen--done');
      setTimeout(() => {
        loader.style.display = 'none';
      }, 850);
    }, 1500);

    // Guaranteed safety timeout: never get stuck indefinitely
    setTimeout(() => {
      clearTimeout(dismissTimer);
      loader.classList.add('loading-screen--done');
      loader.style.display = 'none';
    }, 3200);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLoadingScreen);
  } else {
    initLoadingScreen();
  }
</script>
