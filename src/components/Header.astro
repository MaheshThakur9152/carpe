---
import Logo from './Logo.astro';
import { navigationItems } from '../data/navigation';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
---
<header class={`site-header ${variant}`}>
  <div class="header-inner">
    <!-- Desktop Left Logo -->
    <div class="header-left desktop-only">
      <Logo variant={variant} />
    </div>

    <!-- Mobile Top Center Hamburger (Glenn Spiro style) -->
    <div class="mobile-top-center mobile-only">
      <button 
        type="button" 
        class="mobile-menu-trigger" 
        aria-label="Open Navigation Menu"
        aria-expanded="false"
        data-menu-trigger
      >
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>
    </div>

    <!-- Desktop Right Navigation -->
    <nav class="header-right desktop-only" aria-label="Main Navigation">
      <ul class="nav-list">
        {navigationItems.map(item => (
          <li class="nav-item">
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Fullscreen Luxury Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobile-menu-overlay" aria-hidden="true">
    <div class="mobile-menu-header">
      <button 
        type="button" 
        class="mobile-menu-close" 
        aria-label="Close Menu"
        data-menu-close
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <nav class="mobile-nav-body">
      <span class="mobile-menu-eyebrow">Carpe Diam Bombay</span>
      <ul class="mobile-nav-list">
        {navigationItems.map(item => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
      <p class="mobile-menu-footer-note">High Jewellery Atelier · Bombay</p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    pointer-events: none;
    padding: var(--spacing-header-y) var(--spacing-header-x);
  }

  .header-inner {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: auto;
  }

  .desktop-only {
    display: flex;
  }

  .mobile-only {
    display: none;
  }

  .header-left {
    flex-shrink: 0;
  }

  .header-right {
    flex-shrink: 0;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: clamp(1.4rem, 3vw, 3.5rem);
    margin: 0;
    padding: 0;
    align-items: center;
    flex-wrap: nowrap;
  }

  .nav-item {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link {
    white-space: nowrap;
  }

  .site-header.dark .nav-link {
    color: #1a1a1a;
  }
  .site-header.dark .nav-link:hover {
    color: var(--color-gold);
  }

  /* Mobile: Top center hamburger button */
  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: flex !important;
    }

    .site-header {
      padding: 1.25rem 1.5rem;
    }

    .header-inner {
      justify-content: center;
    }

    .mobile-top-center {
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .mobile-menu-trigger {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 26px;
      height: 14px;
      padding: 0;
      background: none;
      border: none;
      cursor: pointer;
    }

    .menu-line {
      display: block;
      width: 100%;
      height: 1.5px;
      background-color: var(--color-gold);
      border-radius: 1px;
    }
  }

  /* Fullscreen mobile overlay */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(6, 17, 15, 0.98);
    backdrop-filter: blur(16px);
    z-index: 100;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 2.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .mobile-menu-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu-header {
    display: flex;
    justify-content: flex-end;
  }

  .mobile-menu-close {
    color: var(--color-gold);
    padding: 0.5rem;
    cursor: pointer;
  }

  .mobile-nav-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 2.2rem;
  }

  .mobile-menu-eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .mobile-nav-link {
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    transition: color 0.3s ease;
  }

  .mobile-nav-link:hover {
    color: var(--color-gold-light);
  }

  .mobile-menu-footer-note {
    font-size: 0.85rem;
    color: var(--color-gold-muted);
    letter-spacing: 0.08em;
  }
</style>

<script>
  function setupMobileMenu() {
    const trigger = document.querySelector('[data-menu-trigger]');
    const closeBtn = document.querySelector('[data-menu-close]');
    const overlay = document.getElementById('mobile-menu-overlay');

    if (!trigger || !overlay) return;

    function openMenu() {
      overlay?.classList.add('is-active');
      overlay?.setAttribute('aria-hidden', 'false');
      trigger?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      overlay?.classList.remove('is-active');
      overlay?.setAttribute('aria-hidden', 'true');
      trigger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    overlay.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
</script>
