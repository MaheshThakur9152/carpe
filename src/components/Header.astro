---
import Logo from './Logo.astro';
import { navigationItems } from '../data/navigation';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
---
<header class={`site-header ${variant}`}>
  <div class="header-inner">
    <!-- Brand Logo -->
    <div class="header-left">
      <Logo variant={variant} />
    </div>

    <!-- Navigation (Atelier, The Edit, Contact) -->
    <nav class="header-right" aria-label="Main Navigation">
      <ul class="nav-list">
        {navigationItems.map(item => (
          <li class="nav-item">
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    pointer-events: none;
    padding: clamp(1.25rem, 3.5vh, 2.5rem) var(--spacing-header-x);
    box-sizing: border-box;
  }

  .header-inner {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: auto;
  }

  .header-left {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .header-right {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: clamp(1rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    align-items: center;
    flex-wrap: nowrap;
  }

  .nav-item {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 2.4vw, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: #f7f4ed;
    text-decoration: none;
    transition: color 0.3s ease, opacity 0.3s ease;
    cursor: pointer;
    display: inline-block;
    padding: 0.25rem 0;
  }

  .nav-link:hover {
    color: var(--color-gold);
    opacity: 1;
  }

  .site-header.dark .nav-link {
    color: #1a1a1a;
  }

  .site-header.dark .nav-link:hover {
    color: var(--color-gold);
  }

  @media (max-width: 640px) {
    .site-header {
      padding: 1.2rem 1.1rem;
    }

    .nav-list {
      gap: clamp(0.85rem, 3.2vw, 1.4rem);
    }

    .nav-link {
      font-size: clamp(0.88rem, 3.8vw, 1.05rem);
      letter-spacing: 0.03em;
    }
  }

  @media (max-width: 380px) {
    .site-header {
      padding: 1rem 0.85rem;
    }

    .nav-list {
      gap: 0.65rem;
    }

    .nav-link {
      font-size: 0.82rem;
    }
  }
</style>
