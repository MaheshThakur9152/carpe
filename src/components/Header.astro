---
import Logo from './Logo.astro';
import { navigationItems } from '../data/navigation';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
---
<header class={`site-header ${variant}`}>
  <div class="header-inner">
    <!-- Desktop Left Logo -->
    <div class="header-left desktop-only">
      <Logo variant={variant} />
    </div>

    <!-- Mobile Top Center Hamburger (Glenn Spiro reference) -->
    <div class="mobile-top-center mobile-only">
      <button 
        type="button" 
        class="mobile-menu-trigger" 
        aria-label="Open Navigation Menu"
        aria-expanded="false"
        data-menu-trigger
      >
        <span class="menu-line"></span>
        <span class="menu-line"></span>
        <span class="menu-line"></span>
      </button>
    </div>

    <!-- Desktop Right Navigation -->
    <nav class="header-right desktop-only" aria-label="Main Navigation">
      <ul class="nav-list">
        {navigationItems.map(item => (
          <li class="nav-item">
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <!-- Fullscreen Luxury Mobile Menu Overlay -->
  <div class="mobile-menu-overlay" id="mobile-menu-overlay" aria-hidden="true">
    <div class="mobile-menu-header">
      <button 
        type="button" 
        class="mobile-menu-close" 
        aria-label="Close Menu"
        data-menu-close
      >
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
    </div>

    <nav class="mobile-nav-body">
      <span class="mobile-menu-eyebrow">Carpe Diam Bombay</span>
      <ul class="mobile-nav-list">
        {navigationItems.map(item => (
          <li>
            <a href={item.href} class="mobile-nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
      <p class="mobile-menu-footer-note">High Jewellery Atelier · Bombay</p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    pointer-events: none;
    padding: clamp(1.25rem, 3.5vh, 2.5rem) var(--spacing-header-x);
    box-sizing: border-box;
  }

  .header-inner {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: auto;
  }

  .desktop-only {
    display: flex;
  }

  .mobile-only {
    display: none;
  }

  .header-left {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .header-right {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: clamp(1rem, 3vw, 3rem);
    margin: 0;
    padding: 0;
    align-items: center;
    flex-wrap: nowrap;
  }

  .nav-item {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: clamp(0.95rem, 2.4vw, 1.25rem);
    font-weight: 400;
    letter-spacing: 0.05em;
    color: #f7f4ed;
    text-decoration: none;
    transition: color 0.3s ease, opacity 0.3s ease;
    cursor: pointer;
    display: inline-block;
    padding: 0.25rem 0;
  }

  .nav-link:hover {
    color: var(--color-gold);
    opacity: 1;
  }

  .site-header.dark .nav-link {
    color: #1a1a1a;
  }

  .site-header.dark .nav-link:hover {
    color: var(--color-gold);
  }

  /* Mobile / Android: Glenn Spiro reference layout */
  @media (max-width: 768px) {
    .desktop-only {
      display: none !important;
    }

    .mobile-only {
      display: flex !important;
    }

    .site-header {
      padding: max(0.85rem, env(safe-area-inset-top)) 1.5rem 0.5rem;
    }

    .header-inner {
      justify-content: center;
    }

    .mobile-top-center {
      width: 100%;
      display: flex;
      justify-content: center;
      align-items: center;
      pointer-events: auto;
    }

    .mobile-menu-trigger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 4px;
      width: 48px;
      height: 48px;
      padding: 0;
      background: transparent;
      border: none;
      cursor: pointer;
      pointer-events: auto;
      z-index: 60;
      touch-action: manipulation;
    }

    .menu-line {
      display: block;
      width: 32px;
      height: 1.2px;
      background-color: #cbb27a;
      transition: transform 0.3s ease, opacity 0.3s ease;
      pointer-events: none;
    }
  }

  /* Fullscreen mobile overlay */
  .mobile-menu-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
    background-color: rgba(6, 17, 15, 0.98);
    backdrop-filter: blur(16px);
    z-index: 999;
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 2.5rem;
    box-sizing: border-box;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }

  .mobile-menu-overlay.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .mobile-menu-header {
    display: flex;
    justify-content: flex-end;
  }

  .mobile-menu-close {
    background: transparent;
    border: none;
    color: #cbb27a;
    padding: 0.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
  }

  .mobile-nav-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 2.2rem;
  }

  .mobile-menu-eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #cbb27a;
  }

  .mobile-nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .mobile-nav-link {
    font-size: 1.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #ffffff;
    text-decoration: none;
    transition: color 0.3s ease;
    display: inline-block;
    padding: 0.5rem 1rem;
    touch-action: manipulation;
  }

  .mobile-nav-link:hover {
    color: #cbb27a;
  }

  .mobile-menu-footer-note {
    font-size: 0.85rem;
    color: rgba(203, 178, 122, 0.7);
    letter-spacing: 0.08em;
  }
</style>

<script>
  function setupMobileMenu() {
    const trigger = document.querySelector('[data-menu-trigger]');
    const closeBtn = document.querySelector('[data-menu-close]');
    const overlay = document.getElementById('mobile-menu-overlay');

    if (!trigger || !overlay) return;

    function openMenu(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      overlay?.classList.add('is-active');
      overlay?.setAttribute('aria-hidden', 'false');
      trigger?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu(e) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      overlay?.classList.remove('is-active');
      overlay?.setAttribute('aria-hidden', 'true');
      trigger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openMenu);
    closeBtn?.addEventListener('click', closeMenu);

    overlay.querySelectorAll('.mobile-nav-link').forEach(link => {
      link.addEventListener('click', closeMenu);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupMobileMenu);
  } else {
    setupMobileMenu();
  }
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>
