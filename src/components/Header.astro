---
import Logo from './Logo.astro';
import { navigationItems } from '../data/navigation';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
---
<header class={`site-header ${variant}`}>
  <div class="header-inner">
    <div class="header-left">
      <Logo variant={variant} />
    </div>
    <nav class="header-right" aria-label="Main Navigation">
      <ul class="nav-list">
        {navigationItems.map(item => (
          <li class="nav-item">
            <a href={item.href} class="nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 50;
    pointer-events: none;
    padding: var(--spacing-header-y) var(--spacing-header-x);
  }

  .header-inner {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: auto;
    gap: 1rem;
  }

  .header-left {
    flex-shrink: 0;
  }

  .header-right {
    flex-shrink: 0;
  }

  .nav-list {
    display: flex;
    list-style: none;
    gap: clamp(1.4rem, 3vw, 3.5rem);
    margin: 0;
    padding: 0;
    align-items: center;
    flex-wrap: nowrap;
  }

  .nav-item {
    white-space: nowrap;
    flex-shrink: 0;
  }

  .nav-link {
    white-space: nowrap;
  }

  .site-header.dark .nav-link {
    color: #1a1a1a;
  }
  .site-header.dark .nav-link:hover {
    color: var(--color-gold);
  }

  @media (max-width: 768px) {
    .site-header {
      padding: 0.9rem 1.1rem;
    }
    .header-inner {
      gap: 0.75rem;
    }
    .nav-list {
      gap: clamp(0.7rem, 2.6vw, 1.2rem);
    }
  }
</style>
