---
interface Props {
  totalSlides?: number;
}

const { totalSlides = 9 } = Astro.props;
---
<div class="carousel-controls" aria-label="Carousel Navigation">
  <button 
    type="button" 
    class="control-btn prev-btn" 
    aria-label="Previous Slide"
    data-carousel-prev
  >
    <svg width="42" height="22" viewBox="0 0 42 22" fill="none" class="arrow-svg">
      <line x1="1" y1="11" x2="41" y2="11" stroke="#ffffff" stroke-width="1.2" />
      <polyline points="11 2 1 11 11 20" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <button 
    type="button" 
    class="control-btn next-btn" 
    aria-label="Next Slide"
    data-carousel-next
  >
    <svg width="42" height="22" viewBox="0 0 42 22" fill="none" class="arrow-svg">
      <line x1="1" y1="11" x2="41" y2="11" stroke="#ffffff" stroke-width="1.2" />
      <polyline points="31 2 41 11 31 20" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</div>

<style>
  .carousel-controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 20;
  }

  .control-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: auto;
    background: none;
    border: none;
    padding: 12px 6px;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.3s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .control-btn:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
  }

  .control-btn:focus-visible {
    outline: 1px solid var(--color-gold);
    outline-offset: 4px;
  }

  .prev-btn {
    left: clamp(1.2rem, 3vw, 3.2rem);
  }

  .next-btn {
    right: clamp(1.2rem, 3vw, 3.2rem);
  }

  .arrow-svg {
    display: block;
    width: clamp(34px, 3.2vw, 44px);
    height: auto;
  }

  /* Phone / Mobile: Move arrows below the jewellery */
  @media (max-width: 768px) {
    .carousel-controls {
      top: auto;
      bottom: clamp(1.2rem, 3.2vh, 2rem);
      left: 0;
      right: 0;
      height: 44px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 clamp(1.2rem, 4vw, 2rem);
    }

    .control-btn {
      position: static;
      top: auto;
      transform: none;
      padding: 8px;
    }

    .control-btn:hover {
      transform: scale(1.1);
    }

    .prev-btn {
      left: auto;
    }

    .next-btn {
      right: auto;
    }

    .arrow-svg {
      width: 32px;
    }
  }
</style>
