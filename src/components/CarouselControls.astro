---
import Logo from './Logo.astro';

interface Props {
  totalSlides?: number;
}

const { totalSlides = 9 } = Astro.props;
---
<div class="carousel-controls" aria-label="Carousel Navigation">
  <button 
    type="button" 
    class="control-btn prev-btn" 
    aria-label="Previous Slide"
    data-carousel-prev
  >
    <!-- Desktop arrow -->
    <svg width="42" height="22" viewBox="0 0 42 22" fill="none" class="arrow-svg desktop-arrow">
      <line x1="1" y1="11" x2="41" y2="11" stroke="#ffffff" stroke-width="1.2" />
      <polyline points="11 2 1 11 11 20" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <!-- Mobile open chevron (Glenn Spiro style) -->
    <svg width="22" height="34" viewBox="0 0 22 34" fill="none" class="arrow-svg mobile-arrow">
      <polyline points="16 7 6 17 16 27" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <!-- Mobile center logo flanked by arrows -->
  <div class="mobile-center-logo mobile-only">
    <Logo variant="light" />
  </div>

  <button 
    type="button" 
    class="control-btn next-btn" 
    aria-label="Next Slide"
    data-carousel-next
  >
    <!-- Desktop arrow -->
    <svg width="42" height="22" viewBox="0 0 42 22" fill="none" class="arrow-svg desktop-arrow">
      <line x1="1" y1="11" x2="41" y2="11" stroke="#ffffff" stroke-width="1.2" />
      <polyline points="31 2 41 11 31 20" stroke="#ffffff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <!-- Mobile open chevron (Glenn Spiro style) -->
    <svg width="22" height="34" viewBox="0 0 22 34" fill="none" class="arrow-svg mobile-arrow">
      <polyline points="6 7 16 17 6 27" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</div>

<style>
  .carousel-controls {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 20;
  }

  .control-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: auto;
    background: none;
    border: none;
    padding: 12px 6px;
    cursor: pointer;
    opacity: 0.75;
    transition: opacity 0.3s ease, transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
  }

  .control-btn:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.08);
  }

  .control-btn:focus-visible {
    outline: 1px solid var(--color-gold);
    outline-offset: 4px;
  }

  .prev-btn {
    left: clamp(1.2rem, 3vw, 3.2rem);
  }

  .next-btn {
    right: clamp(1.2rem, 3vw, 3.2rem);
  }

  .desktop-arrow {
    display: block;
    width: clamp(34px, 3.2vw, 44px);
    height: auto;
  }

  .mobile-arrow {
    display: none;
  }

  .mobile-center-logo {
    display: none;
  }

  /* Phone / Android: Glenn Spiro layout -> [ < ] [ CARPE DIAM BOMBAY ] [ > ] */
  @media (max-width: 768px) {
    .carousel-controls {
      top: auto;
      bottom: max(clamp(0.75rem, 2dvh, 1.25rem), env(safe-area-inset-bottom));
      left: 0;
      right: 0;
      height: 42px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 clamp(1.2rem, 5vw, 2rem);
      z-index: 30;
    }

    .desktop-arrow {
      display: none;
    }

    .mobile-arrow {
      display: block;
      width: 18px;
      height: 28px;
    }

    .control-btn {
      position: static;
      top: auto;
      transform: none;
      padding: 6px;
      color: var(--color-gold);
      opacity: 0.85;
    }

    .control-btn:hover {
      transform: scale(1.1);
      opacity: 1;
    }

    .prev-btn {
      left: auto;
    }

    .next-btn {
      right: auto;
    }

    .mobile-center-logo {
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: auto;
    }

    .mobile-center-logo :global(.logo-svg) {
      width: clamp(105px, 26vw, 125px);
    }
  }
</style>
