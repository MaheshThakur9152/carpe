---
import Logo from './Logo.astro';
import { navigationItems } from '../data/navigation';
---
<footer class="site-footer editorial-section-reveal" data-reveal-section>
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo variant="light" />
        <p class="brand-tagline">
          High Jewellery Atelier & Bespoke Commissions · Bombay
        </p>
      </div>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <ul class="footer-links">
          {navigationItems.map(item => (
            <li>
              <a href={item.href} class="nav-link">{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        © {new Date().getFullYear()} CARPE DIAM BOMBAY. All Rights Reserved.
      </p>
      <p class="appointment-note">
        Private viewings by prior appointment only.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-bg-darker);
    border-top: 1px solid var(--color-border-subtle);
    padding: clamp(3rem, 6vw, 4.5rem) var(--spacing-header-x) 2.5rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2.5rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .brand-tagline {
    margin-top: 1.2rem;
    font-size: 1rem;
    color: var(--color-gold-muted);
    letter-spacing: 0.05em;
    max-width: 340px;
  }

  .footer-links {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .appointment-note {
    font-style: italic;
    color: var(--color-gold-muted);
  }

  @media (max-width: 640px) {
    .footer-top {
      flex-direction: column;
      gap: 2rem;
    }
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
