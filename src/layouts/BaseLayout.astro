---
import Header from '../components/Header.astro';
import Preloader from '../components/Preloader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  headerVariant?: 'light' | 'dark';
}

const {
  title = 'CARPE DIAM BOMBAY — High Jewellery Atelier',
  description = 'Carpe Diam Bombay. Exceptional handcrafted high jewellery, uncut polki diamonds, carved gemstones and bespoke heirlooms in 14kt gold.',
  headerVariant = 'light'
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/carpediam-logo.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <Preloader />
    <Header variant={headerVariant} />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    width: 100vw;
    height: 100vh;
    overflow: hidden;
  }
</style>
