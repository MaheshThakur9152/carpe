---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  headerVariant?: 'light' | 'dark';
  showFooter?: boolean;
  isHome?: boolean;
}

const {
  title = 'CARPE DIAM BOMBAY — High Jewellery Atelier',
  description = 'Carpe Diam Bombay. Exceptional handcrafted high jewellery, uncut polki diamonds, carved gemstones and bespoke heirlooms in 14kt gold.',
  headerVariant = 'light',
  showFooter = true,
  isHome = false
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en" class={isHome ? 'is-home-page' : ''}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/carpediam-logo.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class={isHome ? 'is-home-page' : ''}>
    <Header variant={headerVariant} />
    <main class={isHome ? 'is-home-main' : ''}>
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>

<style>
  main {
    min-height: 100vh;
  }

  :global(html.is-home-page),
  :global(body.is-home-page) {
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    overflow: hidden !important;
    position: fixed;
    inset: 0;
    width: 100vw;
    margin: 0;
    padding: 0;
    overscroll-behavior: none;
    touch-action: pan-x;
  }

  :global(.is-home-main) {
    height: 100vh;
    height: 100dvh;
    max-height: 100dvh;
    min-height: 0 !important;
    width: 100vw;
    overflow: hidden !important;
    position: relative;
  }
</style>
